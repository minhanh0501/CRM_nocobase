    {
      "parameters": {
        "jsCode": "function formatDate(dateStr) {\n  if (!dateStr) return \"\";\n  const [year, month, day] = dateStr.split(\"-\");\n  return `${day}/${month}/${year}`;\n}\n\nfunction formatCurrency(number) {\n  if (!number) return \"\";\n  return parseInt(number).toLocaleString(\"vi-VN\");\n}\n\nfunction numberToVietnameseText(number) {\n  const units = [\"\", \"một\", \"hai\", \"ba\", \"bốn\", \"năm\", \"sáu\", \"bảy\", \"tám\", \"chín\"];\n  const scales = [\"\", \"nghìn\", \"triệu\", \"tỷ\"];\n\n  function readThreeDigits(num) {\n    let hundred = Math.floor(num / 100);\n    let ten = Math.floor((num % 100) / 10);\n    let unit = num % 10;\n    let result = \"\";\n\n    if (hundred > 0) result += units[hundred] + \" trăm \";\n\n    if (ten > 1) {\n      result += units[ten] + \" mươi \";\n      if (unit === 1) result += \"mốt \";\n      else if (unit === 5) result += \"lăm \";\n      else if (unit > 0) result += units[unit] + \" \";\n    } else if (ten === 1) {\n      result += \"mười \";\n      if (unit === 5) result += \"lăm \";\n      else if (unit > 0) result += units[unit] + \" \";\n    } else if (unit > 0) {\n      result += \"lẻ \" + units[unit] + \" \";\n    }\n\n    return result.trim();\n  }\n\n  number = parseInt(number);\n  if (isNaN(number)) return \"\";\n\n  let result = \"\";\n  let scaleIndex = 0;\n\n  while (number > 0) {\n    let chunk = number % 1000;\n    if (chunk > 0) {\n      result =\n        readThreeDigits(chunk) +\n        \" \" +\n        scales[scaleIndex] +\n        \" \" +\n        result;\n    }\n    number = Math.floor(number / 1000);\n    scaleIndex++;\n  }\n\n  return result.trim() + \" đồng\";\n}\n\n// 🔥 Lấy dữ liệu từ Webhook\nconst data = $node[\"Webhook\"].json.query;\n\n// Format ngày\ndata.ngay_ky_hop_dong_format = formatDate(data.ngay_ky_hop_dong);\ndata.ngay_het_han_format = formatDate(data.ngay_het_han);\n\n// 🔥 Format lại chính biến tiền\nconst originalAmount = data.tong_gia_tri_hop_dong;\ndata.tong_gia_tri_hop_dong = formatCurrency(originalAmount);\n\n// Đọc tiền thành chữ (dùng số gốc)\ndata.tong_gia_tri_hop_dong_text = numberToVietnameseText(originalAmount);\n\nreturn { json: data };"
      },
